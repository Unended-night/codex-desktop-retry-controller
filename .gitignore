# Public source allowlist; all local data and unlisted files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/app.pyw
!/desktop_runtime.py
!/desktop_trial.py
!/desktop_validation.py
!/desktop_storage.py
!/desktop_processes.py
!/desktop_shell.py
!/windows_shell.py
!/repair_shortcut_icons.ps1
!/启动控制器.cmd

!/controller/
/controller/*
!/controller/*.py

!/tests/
/tests/*
!/tests/README.md
!/tests/test_*.py
!/tests/verify_*.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/outlined-retry.json
!/tests/fixtures/retry-scope.json

!/research/
/research/*
!/research/README.md
!/research/probe_retries.py
!/research/appserver_probe.py
!/research/debug_probe.py
!/research/verify_desktop_runtime.py
!/research/verify_native_config.py

!/assets/
/assets/*
!/assets/README.md

!/docs/
/docs/*
!/docs/COMPATIBILITY.md
!/docs/SHORTCUTS.md
!/docs/ARCHITECTURE.md
!/docs/MAINTENANCE.md
!/docs/PUBLICATION.md

# Defense in depth inside allowed directories.
**/__pycache__/
**/.env
**/.env.*
*.py[cod]
*.lnk
*.exe
*.dll
*.ico
*.db
*.sqlite*
